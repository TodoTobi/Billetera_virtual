# ============================================================
# .env.example — Copiá este archivo como .env y completá los valores
# NUNCA subas el .env real al repositorio
# ============================================================

# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=billetera_db

# JWT — Generá un string aleatorio de al menos 64 chars
# En terminal: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=6b82dde5a6fa2c7939b6dbc785ddce5a19a62903abc738fb525b9604defc4f1be8702d325d26ecc246f8435acec43f81fa7fc2b52d69045c609b75e2907522aa

# BCrypt rounds (recomendado: 12)
BCRYPT_ROUNDS=12

# Orígenes permitidos en CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Puerto del servidor
PORT=3000
